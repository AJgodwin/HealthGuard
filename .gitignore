# =============================================================================
# HealthGuard - Root .gitignore
# =============================================================================

# ---- Node.js ----------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-store/

# ---- Build output -----------------------------------------------------------
/dist/
/build/
/.next/
/out/
*.class
*.pyc

# ---- Environment & Secrets --------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.cert

# ---- Logs -------------------------------------------------------------------
*.log
logs/
server.log
tts_error.txt
tts_result.txt

# ---- Temporary files --------------------------------------------------------
*.tmp
*.temp
.cache/

# ---- OS / Editor files ------------------------------------------------------
.DS_Store
Thumbs.db
ehthumbs.db
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ---- Test / Debug artifacts -------------------------------------------------
coverage/
.nyc_output/
junit.xml
test-results/

# ---- Misc -------------------------------------------------------------------
*.tsbuildinfo
.eslintcache
